<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.symphony.linear-mcp</string>

  <key>WorkingDirectory</key>
  <string>/opt/symphony/runner</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/python3</string>
    <string>-m</string>
    <string>symphony</string>
    <string>/opt/symphony/config/WORKFLOW.linear-mcp.example.md</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/var/tmp/symphony-example.out.log</string>

  <key>StandardErrorPath</key>
  <string>/var/tmp/symphony-example.err.log</string>
</dict>
</plist>
